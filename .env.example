# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- Database (required) ---------------------------------------------------
# Local Postgres, Supabase, or Neon. Prisma 7 connects through the pg driver adapter.
DATABASE_URL="postgresql://postgres@localhost:5432/wcios?schema=public"

# --- Human auth (optional in dev) ------------------------------------------
# When these are unset, the app falls back to a local dev admin user so it runs
# without secrets. That fallback is DISABLED when NODE_ENV=production — a production
# deploy must set both of these.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."

# --- AI estimate assistant (optional) ---------------------------------------
# Without this, the AI Estimate admin page and POST /api/v1/estimates/ai-draft
# return a clear "not configured" error rather than the app failing to build.
# ANTHROPIC_API_KEY="sk-ant-..."

# --- Client Portal payments (optional) --------------------------------------
# Without these, POST /api/v1/portal/invoices/{id}/pay returns a clean 503 and
# the Stripe webhook receiver returns 503 rather than accepting unverifiable events.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Scheduled tasks (optional) ----------------------------------------------
# Without this, POST/GET /api/v1/webhooks/process (webhook-delivery retry +
# Draw auto-invoice generation) always returns 401. Set it and add a scheduler
# hitting that path with `Authorization: Bearer <this value>` — Vercel Cron
# (see vercel.json) sends that header automatically when this var is named
# CRON_SECRET; any other scheduler (GitHub Actions, cron-job.org, ...) works
# the same way as long as it sends that header.
# CRON_SECRET="a-long-random-string"

# --- Job file storage (optional) --------------------------------------------
# Without these, file upload endpoints return a clear "not configured" error.
# Use the Supabase project's own URL and its service-role key (Storage write
# access) — never the anon/public key. Server-side only, never in a client bundle.
# SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="..."

# --- Local development conveniences ----------------------------------------
# Which organization the seed script creates and the dev auth fallback signs into.
DEV_ORGANIZATION_SLUG="world-construction"
DEV_USER_EMAIL="dev@worldconstructioninc.com"
