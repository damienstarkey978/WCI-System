# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- Database (required) ---------------------------------------------------
# Local Postgres, Supabase, or Neon. Prisma 7 connects through the pg driver adapter.
DATABASE_URL="postgresql://postgres@localhost:5432/wcios?schema=public"

# --- Human auth (optional in dev) ------------------------------------------
# When these are unset, the app falls back to a local dev admin user so it runs
# without secrets. That fallback is DISABLED when NODE_ENV=production — a production
# deploy must set both of these.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."

# --- AI estimate assistant (optional) ---------------------------------------
# Without this, the AI Estimate admin page and POST /api/v1/estimates/ai-draft
# return a clear "not configured" error rather than the app failing to build.
# ANTHROPIC_API_KEY="sk-ant-..."

# --- Local development conveniences ----------------------------------------
# Which organization the seed script creates and the dev auth fallback signs into.
DEV_ORGANIZATION_SLUG="world-construction"
DEV_USER_EMAIL="dev@worldconstructioninc.com"
