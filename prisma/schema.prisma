// WCI OS — Phase 0 schema.
// See CLAUDE.md section 2.3 for the full target data model. Only the Phase 0 subset
// (Organization, User, Job, CostCode + the auth/permission scaffolding) is implemented here.
// Job is the aggregate root: every entity added in later phases belongs to exactly one Job.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Coarse capability boundary (CLAUDE.md 2.4, layer 1).
enum UserRole {
  ADMIN
  PM
  OFFICE
  FIELD
  AGENT
}

/// Which Jarvis-system agent a machine consumer represents (CLAUDE.md section 6).
enum AgentKind {
  JARVIS
  HEATHER
  DUKE
  HANK
  VINCE
  NEIL
}

/// Branches markup / invoice / report logic system-wide. Never treat as a display
/// label — behavior lives in src/lib/contract-type/.
enum ContractType {
  FIXED_PRICE
  OPEN_BOOK
}

/// Job lifecycle. Transitions are guarded by src/lib/job-status.ts — never assign directly.
enum JobStatus {
  PRE_SALE
  OPEN
  WARRANTY
  CLOSED
}

enum CostType {
  LABOR
  MATERIAL
  EQUIPMENT
  SUBCONTRACTOR
  OTHER
  NONE
}

/// Permission Wizard equivalent: how much of a job's schedule a user may see.
enum ScheduleScope {
  ASSIGNED_ONLY
  ALL_ITEMS
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  /// Clerk organization id, once the org is linked to Clerk. Null in local/dev.
  clerkOrgId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users        User[]
  jobs         Job[]
  jobGroups    JobGroup[]
  costCodes    CostCode[]
  apiKeys      ApiKey[]
  oauthClients OAuthClient[]

  estimates             Estimate[]
  purchaseOrders        PurchaseOrder[]
  bills                 Bill[]
  webhookSubscriptions  WebhookSubscription[]
  invoices              Invoice[]
  drawSchedules         DrawSchedule[]
  payments              Payment[]
  timeClockEntries      TimeClockEntry[]
  nonWorkingDays        NonWorkingDay[]
  schedules             Schedule[]
  changeOrders          ChangeOrder[]
  dailyLogs             DailyLog[]
  todos                 Todo[]
  rfis                  Rfi[]
  files                 File[]
  comments              Comment[]
  notifications         Notification[]
  clients               Client[]
  clientActionTokens    ClientActionToken[]
  allowances            Allowance[]
  selections            Selection[]
  vendors               Vendor[]
  vendorActionTokens    VendorActionToken[]
  bidPackages           BidPackage[]
  leads                 Lead[]
  leadActivities        LeadActivity[]
  proposals             Proposal[]
  specifications        Specification[]
  submittals            Submittal[]
  warrantyClaims        WarrantyClaim[]
  surveys               Survey[]
  clientUpdateSummaries ClientUpdateSummary[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Clerk user id for human staff. Null for agent users, which authenticate via ApiKey.
  clerkUserId String?    @unique
  email       String
  name        String?
  role        UserRole   @default(FIELD)
  /// Set only when role = AGENT.
  agentKind   AgentKind?
  isActive    Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobGrants                 JobAccessGrant[]
  createdApiKeys            ApiKey[]         @relation("ApiKeyCreatedBy")
  jobStatusEvents           JobStatusEvent[]
  timeClockEntries          TimeClockEntry[] @relation("TimeClockEntryUser")
  approvedTimeClockEntries  TimeClockEntry[] @relation("TimeClockEntryApprovedBy")
  clockedInTimeClockEntries TimeClockEntry[] @relation("TimeClockEntryClockedInBy")
  authoredDailyLogs         DailyLog[]
  assignedTodos             Todo[]
  assignedRfis              Rfi[]
  uploadedFiles             File[]
  authoredComments          Comment[]
  notifications             Notification[]
  assignedLeads             Lead[]
  leadActivities            LeadActivity[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Job — the aggregate root
// ---------------------------------------------------------------------------

/// Multi-family / subdivision rollup container (CLAUDE.md 2.3, Job.jobGroupId).
model JobGroup {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  jobs Job[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Job {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  jobGroupId String?
  jobGroup   JobGroup? @relation(fields: [jobGroupId], references: [id], onDelete: SetNull)

  /// Short job code used across POs and bills, e.g. "283RC". Duke's road-name matching
  /// (Phase 1) keys off this plus the street address.
  prefix       String?
  name         String
  contractType ContractType
  status       JobStatus    @default(PRE_SALE)

  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  postalCode           String?
  /// Used by the weather lookup on Daily Logs (Phase 2) and time-clock geofencing.
  latitude             Float?
  longitude            Float?
  /// Null means no geofence is enforced for this job, even if latitude/longitude are set.
  geofenceRadiusMeters Int?

  sqft         Int?
  permitNumber String?
  lotInfo      String?

  projectedStart DateTime?
  projectedEnd   DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  scheduleColor  String?

  customFields Json    @default("{}")
  /// Jobs are templatable, like estimates/schedules/specs.
  isTemplate   Boolean @default(false)

  /// Which funnel layer drives projectedCost, and whether actual cost counts
  /// open bills (accrual) or only paid ones (cash). Per-job because different
  /// clients and lenders want the job reported differently.
  projectionReference ProjectionReference @default(GREATEST)
  accountingBasis     AccountingBasis     @default(ACCRUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents JobStatusEvent[]
  accessGrants JobAccessGrant[]

  estimates             Estimate[]
  budgetLines           BudgetLine[]
  purchaseOrders        PurchaseOrder[]
  bills                 Bill[]
  invoices              Invoice[]
  drawSchedules         DrawSchedule[]
  timeClockEntries      TimeClockEntry[]
  schedules             Schedule[]
  changeOrders          ChangeOrder[]
  dailyLogs             DailyLog[]
  todos                 Todo[]
  rfis                  Rfi[]
  files                 File[]
  clientAccess          ClientJobAccess[]
  allowances            Allowance[]
  selections            Selection[]
  vendorAccess          VendorJobAccess[]
  bidPackages           BidPackage[]
  /// Set only when this Job was created by the explicit Lead -> Job conversion
  /// action (src/lib/crm/service.ts) — null for a job created any other way.
  convertedFromLead     Lead?
  proposals             Proposal[]
  specifications        Specification[]
  submittals            Submittal[]
  warrantyClaims        WarrantyClaim[]
  surveys               Survey[]
  clientUpdateSummaries ClientUpdateSummary[]

  @@unique([organizationId, prefix])
  @@index([organizationId, status])
  @@index([jobGroupId])
}

/// Append-only audit of every status transition. Written by transitionJobStatus()
/// in src/lib/job-status.ts — the only supported way to change Job.status.
model JobStatusEvent {
  id    String     @id @default(cuid())
  jobId String
  job   Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  from  JobStatus?
  to    JobStatus

  /// Exactly one actor is set, depending on whether a human or an agent made the change.
  actorUserId   String?
  actorUser     User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorApiKeyId String?
  actorApiKey   ApiKey? @relation(fields: [actorApiKeyId], references: [id], onDelete: SetNull)

  reason    String?
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
}

/// Permission model layer 2 (CLAUDE.md 2.4): (User × Job) grants.
model JobAccessGrant {
  id     String @id @default(cuid())
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scheduleScope            ScheduleScope @default(ASSIGNED_ONLY)
  canViewPricing           Boolean       @default(false)
  canViewCostDetail        Boolean       @default(false)
  canManageSchedule        Boolean       @default(false)
  canApproveChangeOrders   Boolean       @default(false)
  canViewDocuments         Boolean       @default(true)
  canCommunicateWithClient Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Cost code catalog (org-level, not per-job)
// ---------------------------------------------------------------------------

model CostCode {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code            String
  name            String
  defaultCostType CostType @default(NONE)

  /// Supports the cost-code hierarchy the Estimate builder groups by (Phase 1).
  parentId String?
  parent   CostCode?  @relation("CostCodeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children CostCode[] @relation("CostCodeHierarchy")

  /// Only meaningful for LABOR cost codes. Snapshotted onto each TimeClockEntry at
  /// clock-in, so this is the *current* rate — past entries are unaffected by edits.
  defaultHourlyRateCents Int?

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeClockEntries       TimeClockEntry[]
  changeOrderLineItems   ChangeOrderLineItem[]
  estimateLineItems      EstimateLineItem[]
  budgetLines            BudgetLine[]
  purchaseOrderLineItems PurchaseOrderLineItem[]
  billLineItems          BillLineItem[]
  allowances             Allowance[]
  bidPackageLineItems    BidPackageLineItem[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Machine auth — deliberately separate from human session auth (CLAUDE.md 2.1)
// ---------------------------------------------------------------------------

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Human-readable consumer name: "duke", "heather", "jarvis", ...
  name      String
  agentKind AgentKind?

  /// Public, non-secret identifier embedded in the token and safe to display.
  tokenId      String @unique
  /// SHA-256 of the secret half of the token. The plaintext is shown exactly once.
  hashedSecret String

  scopes             String[]
  rateLimitPerMinute Int      @default(120)

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdByUserId String?
  createdBy       User?   @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobStatusEvents JobStatusEvent[]

  @@index([organizationId])
}

/// OAuth2 client-credentials consumer. Modelled in Phase 0; the token endpoint lands
/// with the full public API in Phase 1.
model OAuthClient {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name               String
  agentKind          AgentKind?
  clientId           String     @unique
  hashedClientSecret String
  scopes             String[]

  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Phase 1 — financial core
//
// Money is always integer cents. Quantities are integer thousandths
// (quantityMilli), so 2.5 units is 2500 — this keeps every calculation in
// integer arithmetic, per CLAUDE.md section 5.
// ---------------------------------------------------------------------------

/// Whether a rate is applied as a markup on cost or a margin on price.
enum RateMode {
  MARKUP
  MARGIN
}

enum EstimateStatus {
  DRAFT
  SENT
  LOCKED
  ACCEPTED
  DECLINED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  DECLINED
  COMPLETED
  CANCELLED
}

enum BillApprovalStatus {
  IN_REVIEW
  APPROVED
  READY_FOR_PAYMENT
  PAID
  VOID
}

/// Which layer of the funnel drives projectedCost. GREATEST is Buildertrend's
/// default behavior and the safest: a job is projected at the worst known number.
enum ProjectionReference {
  GREATEST
  REVISED_BUDGET
  COMMITTED
  ACTUAL
}

/// Accrual counts open + paid bills as actual cost; cash counts only paid bills.
enum AccountingBasis {
  ACCRUAL
  CASH
}

/// Where a purchase order came from. Conversions are explicit, back-referenced
/// actions (CLAUDE.md 2.3) so a line can always be traced to its origin.
enum FinancialSourceType {
  SCRATCH
  ESTIMATE
  CHANGE_ORDER
  BID
  SELECTION
}

model Estimate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  title   String
  status  EstimateStatus @default(DRAFT)
  /// Bumped when a locked estimate is revised, preserving history.
  version Int            @default(1)

  /// Default pricing rate applied to new line items.
  rateMode               RateMode @default(MARKUP)
  defaultRateBasisPoints Int      @default(0)

  sentAt         DateTime?
  lockedAt       DateTime?
  acceptedAt     DateTime?
  /// Set by the "Send to Job Budget" action, which locks the estimate.
  sentToBudgetAt DateTime?

  /// True when this estimate was drafted by the AI assistant from field notes
  /// rather than entered by hand. Always created as DRAFT for human review —
  /// never sent to budget automatically (CLAUDE.md Phase 8 principle: a human
  /// reviews AI-drafted numbers before they touch money).
  aiGenerated   Boolean @default(false)
  /// The field notes the AI draft was generated from, kept for audit/re-generation.
  aiPromptNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems               EstimateLineItem[]
  proposals               Proposal[]
  generatedSpecifications Specification[]

  @@index([organizationId])
  @@index([jobId, status])
}

model EstimateLineItem {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  costCodeId String
  costCode   CostCode @relation(fields: [costCodeId], references: [id], onDelete: Restrict)
  costType   CostType @default(NONE)

  title         String
  description   String?
  /// Quantity × 1000. 2.5 units is stored as 2500.
  quantityMilli Int     @default(1000)
  unitCostCents Int     @default(0)

  rateMode        RateMode @default(MARKUP)
  rateBasisPoints Int      @default(0)

  taxable      Boolean @default(false)
  internalNote String?
  /// Free-form grouping (room, assembly) for the estimate worksheet.
  groupLabel   String?
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estimateId, sortOrder])
  @@index([costCodeId])
}

/// One row per Job × CostCode. Stores only the *authored* numbers (what was
/// budgeted and what the client was quoted). Every other layer of the funnel —
/// pending, committed, actual, projected, cost-to-complete — is computed from
/// POs and bills by src/lib/budget/funnel.ts and deliberately not stored.
model BudgetLine {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  costCodeId String
  costCode   CostCode @relation(fields: [costCodeId], references: [id], onDelete: Restrict)

  originalBudgetCostCents Int @default(0)
  /// Original plus approved change orders and selections.
  revisedBudgetCostCents  Int @default(0)

  originalClientPriceCents Int @default(0)
  revisedClientPriceCents  Int @default(0)

  rateMode        RateMode @default(MARKUP)
  rateBasisPoints Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, costCodeId])
  @@index([jobId])
}

model PurchaseOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  poNumber String
  /// Reconciliation suffix used when a PO is billed in parts (CLAUDE.md 2.3).
  poSuffix String?

  /// Free-text vendor name — kept even once vendorId (Phase 4) is set, since a PO can
  /// be cut to a vendor with no portal account at all.
  vendorName String
  /// Set only when the vendor has a Vendor Portal account (Phase 4). Nullable rather
  /// than required: not every PO's vendor is onboarded to the portal.
  vendorId   String?
  vendor     Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  status PurchaseOrderStatus @default(DRAFT)

  sourceType FinancialSourceType @default(SCRATCH)
  /// Id of the originating record, so a PO can be traced back to its source.
  sourceId   String?

  /// Amend-in-place with version history.
  version    Int       @default(1)
  approvedAt DateTime?
  declinedAt DateTime?

  vendorSignatureName String?
  vendorSignedAt      DateTime?
  vendorSignatureIp   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems PurchaseOrderLineItem[]
  bills     Bill[]

  @@unique([organizationId, poNumber])
  @@index([jobId, status])
  @@index([vendorId])
}

model PurchaseOrderLineItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  costCodeId String
  costCode   CostCode @relation(fields: [costCodeId], references: [id], onDelete: Restrict)
  costType   CostType @default(NONE)

  title         String
  quantityMilli Int    @default(1000)
  unitCostCents Int    @default(0)
  sortOrder     Int    @default(0)

  @@index([purchaseOrderId, sortOrder])
  @@index([costCodeId])
}

model Bill {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// Set when the bill was raised against a PO, which is what makes PO-to-bill
  /// reconciliation possible.
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  vendorName String
  /// Set only when the vendor has a Vendor Portal account (Phase 4).
  vendorId   String?
  vendor     Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  billNumber String?

  approvalStatus BillApprovalStatus @default(IN_REVIEW)

  issuedOn DateTime?
  dueOn    DateTime?
  paidAt   DateTime?

  /// True when the bill was drafted from a scanned receipt (Phase 8 OCR).
  fromOcr Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems BillLineItem[]

  @@index([jobId, approvalStatus])
  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([vendorId])
}

model BillLineItem {
  id     String @id @default(cuid())
  billId String
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  costCodeId String
  costCode   CostCode @relation(fields: [costCodeId], references: [id], onDelete: Restrict)
  costType   CostType @default(NONE)

  title       String
  amountCents Int    @default(0)
  sortOrder   Int    @default(0)

  @@index([billId, sortOrder])
  @@index([costCodeId])
}

// ---------------------------------------------------------------------------
// Webhooks — how the Jarvis agents react to events instead of polling
// ---------------------------------------------------------------------------

model WebhookSubscription {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Which consumer owns this subscription ("duke", "jarvis", ...).
  name       String
  targetUrl  String
  /// Shared secret used to sign payloads (HMAC-SHA256).
  secret     String
  eventTypes String[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([organizationId, isActive])
}

/// Delivery log, so a failed webhook is visible and retryable rather than
/// silently dropped — the same principle as the QuickBooks sync log.
model WebhookDelivery {
  id             String              @id @default(cuid())
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  eventType String
  payload   Json
  /// Stable id used for idempotent redelivery.
  eventId   String

  attempts       Int       @default(0)
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  lastStatusCode Int?
  lastError      String?
  nextAttemptAt  DateTime?

  createdAt DateTime @default(now())

  @@index([subscriptionId, deliveredAt])
  @@index([nextAttemptAt])
}

// ---------------------------------------------------------------------------
// Invoicing, draw schedules, payments
// ---------------------------------------------------------------------------

enum InvoiceType {
  FLAT
  LINE_ITEM
  PROGRESS
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  STRIPE_CARD
  STRIPE_ACH
  QBO_SYNC
  MANUAL
}

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  type          InvoiceType
  status        InvoiceStatus @default(DRAFT)
  invoiceNumber String

  /// Authoritative total. For LINE_ITEM/PROGRESS this must equal the sum of
  /// lineItems — enforced in src/lib/invoicing/service.ts, not by a DB constraint.
  amountCents Int

  issuedOn DateTime?
  dueOn    DateTime?
  paidAt   DateTime?
  voidedAt DateTime?

  /// Set when this invoice was auto-generated from a Draw (CLAUDE.md 2.3:
  /// "DrawSchedule -> Draw ... autoGeneratesInvoiceOnDate"). One draw generates at
  /// most one invoice.
  drawId String? @unique
  draw   Draw?   @relation(fields: [drawId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([jobId, status])
}

model InvoiceLineItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  title       String
  description String?
  amountCents Int
  sortOrder   Int     @default(0)

  @@index([invoiceId, sortOrder])
}

/// One per job in the common case, though nothing here enforces that — a job could
/// have a superseding schedule if terms are renegotiated.
model DrawSchedule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  name String @default("Draw Schedule")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draws Draw[]

  @@index([jobId])
}

model Draw {
  id             String       @id @default(cuid())
  drawScheduleId String
  drawSchedule   DrawSchedule @relation(fields: [drawScheduleId], references: [id], onDelete: Cascade)

  title                    String
  pctOfContractBasisPoints Int
  sortOrder                Int    @default(0)

  /// Forward reference to a ScheduleItem — no FK yet, since Schedule/ScheduleItem
  /// land in Phase 2. Wire this into a real relation once that model exists.
  linkedScheduleItemId       String?
  autoGeneratesInvoiceOnDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Set once "generate draft invoice" has run for this draw (CLAUDE.md 2.3). A
  /// draw generates at most one invoice — regenerating requires voiding it first.
  invoice Invoice?

  @@index([drawScheduleId, sortOrder])
}

model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  method      PaymentMethod
  amountCents Int
  /// Check number, Stripe payment intent id, QBO transaction id, etc.
  reference   String?
  receivedAt  DateTime      @default(now())

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Time tracking
// ---------------------------------------------------------------------------

enum TimeClockApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GeofenceStatus {
  /// GPS was provided and fell within the job's configured radius.
  INSIDE
  /// GPS was provided and fell outside the job's configured radius.
  OUTSIDE
  /// No geofence to check against: no GPS provided, or the job has none configured.
  NOT_APPLICABLE
}

enum LaborRateSource {
  COST_CODE_DEFAULT
  MANUAL_OVERRIDE
}

model TimeClockEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("TimeClockEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  costCodeId     String
  costCode       CostCode     @relation(fields: [costCodeId], references: [id], onDelete: Restrict)

  clockInAt  DateTime
  clockOutAt DateTime?

  gpsInLatitude   Float?
  gpsInLongitude  Float?
  gpsOutLatitude  Float?
  gpsOutLongitude Float?
  /// Checked at clock-in. Clock-out is re-checked but does not overwrite this — an
  /// entry that started outside the geofence stays flagged even if the worker
  /// wanders back before clocking out.
  geofenceStatus  GeofenceStatus @default(NOT_APPLICABLE)

  approvalStatus   TimeClockApprovalStatus @default(PENDING)
  approvedByUserId String?
  approvedByUser   User?                   @relation("TimeClockEntryApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?

  /// Snapshotted at clock-in so a later change to the cost code's default rate
  /// never rewrites the cost of hours already worked.
  hourlyRateCents Int
  rateSource      LaborRateSource @default(COST_CODE_DEFAULT)

  /// Set when a supervisor clocked this worker in on their behalf.
  clockedInByUserId String?
  clockedInByUser   User?   @relation("TimeClockEntryClockedInBy", fields: [clockedInByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  breaks TimeClockBreak[]

  @@index([organizationId, userId])
  @@index([jobId, approvalStatus])
}

model TimeClockBreak {
  id               String         @id @default(cuid())
  timeClockEntryId String
  timeClockEntry   TimeClockEntry @relation(fields: [timeClockEntryId], references: [id], onDelete: Cascade)

  startAt DateTime
  endAt   DateTime?

  @@index([timeClockEntryId])
}

// ---------------------------------------------------------------------------
// Phase 2 — Scheduling
// ---------------------------------------------------------------------------

enum ScheduleItemConfirmationStatus {
  UNCONFIRMED
  CONFIRMED
}

/// Org-wide non-working days (holidays, shutdowns) the scheduling engine skips
/// over. Per-job overrides can be layered on later; a shared org calendar is the
/// common case and keeps this simple for v1.
model NonWorkingDay {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  date   DateTime
  reason String?

  createdAt DateTime @default(now())

  @@unique([organizationId, date])
  @@index([organizationId])
}

/// One per job in the common case, mirroring DrawSchedule's shape.
model Schedule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  name String @default("Schedule")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ScheduleItem[]

  @@index([jobId])
}

model ScheduleItem {
  id         String   @id @default(cuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  title        String
  /// Working-day duration. Start/end dates are computed, not stored — see
  /// src/lib/scheduling/cpm.ts — the same "computed not stored where possible"
  /// principle CLAUDE.md 2.3 applies to the Budget.
  durationDays Int    @default(1)

  /// Ids of other ScheduleItems in the same schedule this one cannot start before.
  predecessorIds String[]
  /// Working days between a predecessor's finish and this item's earliest start.
  lagDays        Int      @default(0)

  /// Only meaningful for items with no predecessors — the anchor date the engine
  /// propagates everything else from.
  manualStartDate DateTime?

  /// Captured only by an explicit "snapshot baseline" action, never auto-updated.
  baselineStart DateTime?
  baselineEnd   DateTime?

  confirmationStatus ScheduleItemConfirmationStatus @default(UNCONFIRMED)
  clientVisible      Boolean                        @default(true)
  subVisible         Boolean                        @default(true)
  assigneeUserIds    String[]

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId, sortOrder])
}

// ---------------------------------------------------------------------------
// Phase 2 — Change Orders (wired into the Budget)
// ---------------------------------------------------------------------------

enum ChangeOrderMode {
  FLAT
  ITEMIZED
}

enum ChangeOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  DECLINED
}

model ChangeOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  title  String
  mode   ChangeOrderMode
  status ChangeOrderStatus @default(DRAFT)

  /// FLAT mode only: the cost code the cost side is booked against, and the raw
  /// cost/price deltas entered directly (a flat CO does not recompute a markup).
  flatCostCodeId       String?
  flatCostCents        Int?
  flatClientPriceCents Int?

  clientSignatureName String?
  clientSignedAt      DateTime?
  clientSignatureIp   String?
  approvedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems ChangeOrderLineItem[]

  @@index([jobId, status])
}

model ChangeOrderLineItem {
  id            String      @id @default(cuid())
  changeOrderId String
  changeOrder   ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)

  costCodeId String
  costCode   CostCode @relation(fields: [costCodeId], references: [id], onDelete: Restrict)
  costType   CostType @default(NONE)

  title           String
  quantityMilli   Int      @default(1000)
  unitCostCents   Int      @default(0)
  rateMode        RateMode @default(MARKUP)
  rateBasisPoints Int      @default(0)
  sortOrder       Int      @default(0)

  @@index([changeOrderId, sortOrder])
}

// ---------------------------------------------------------------------------
// Phase 2 — Daily Logs, Todos, RFIs, Files
// ---------------------------------------------------------------------------

model DailyLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorUserId   String
  authorUser     User         @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  note String

  /// Populated only when a weather provider is configured — see
  /// src/lib/daily-logs/weather.ts. Null otherwise, never a fabricated value.
  weather Json?

  clientVisible Boolean @default(true)
  subVisible    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files File[]

  @@index([jobId, createdAt])
}

enum TodoStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
}

/// The generic entity that also covers punch lists (CLAUDE.md 2.3) — `category`
/// is a freeform filter tag ("punch", "milestone"), not a schema split.
model Todo {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      TodoStatus   @default(OPEN)
  priority    TodoPriority @default(MEDIUM)
  dueDate     DateTime?
  category    String?

  assigneeUserId String?
  assigneeUser   User?   @relation(fields: [assigneeUserId], references: [id], onDelete: SetNull)

  clientVisible Boolean @default(false)
  subVisible    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklistItems TodoChecklistItem[]

  @@index([jobId, status])
  @@index([category])
}

model TodoChecklistItem {
  id     String @id @default(cuid())
  todoId String
  todo   Todo   @relation(fields: [todoId], references: [id], onDelete: Cascade)

  title     String
  isDone    Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([todoId, sortOrder])
}

enum RfiStatus {
  OPEN
  ANSWERED
  CLOSED
}

model Rfi {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  title    String
  question String
  status   RfiStatus @default(OPEN)
  dueDate  DateTime?

  assigneeUserId String?
  assigneeUser   User?   @relation(fields: [assigneeUserId], references: [id], onDelete: SetNull)

  answer     String?
  answeredAt DateTime?

  /// Freeform polymorphic reference ("schedule_item:abc123") — no FK, since the
  /// referent can be any module.
  relatedItemRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, status])
}

enum FileCategory {
  DOCUMENT
  PHOTO
  VIDEO
}

model File {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  fileName  String
  /// External URL — no S3/R2 integration yet (needs storage credentials); the
  /// caller uploads elsewhere and registers the resulting URL here.
  url       String
  mimeType  String?
  sizeBytes Int?
  category  FileCategory @default(DOCUMENT)

  clientVisible Boolean @default(true)
  subVisible    Boolean @default(true)

  uploadedByUserId String
  uploadedByUser   User   @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  /// Set when this file was attached to a Daily Log entry (photos/videos).
  dailyLogId String?
  dailyLog   DailyLog? @relation(fields: [dailyLogId], references: [id], onDelete: SetNull)

  /// Set when this file is an image attached to a Selection option.
  selectionOptionId String?
  selectionOption   SelectionOption? @relation(fields: [selectionOptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([jobId, category])
  @@index([dailyLogId])
  @@index([selectionOptionId])
}

// ---------------------------------------------------------------------------
// Phase 2 — Unified Comment/Activity layer + Notifications
// ---------------------------------------------------------------------------

/// One table for comments across every module (CLAUDE.md 2.3), not per-module
/// comment tables. featureType is a plain string ("DailyLog", "Todo", "Rfi",
/// "ChangeOrder", "PurchaseOrder", "Bill", ...) rather than an enum, so a new
/// module never needs a migration just to be commentable.
model Comment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  featureType String
  featureId   String

  authorUserId String?
  authorUser   User?   @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  body     String
  mentions String[]

  createdAt DateTime @default(now())

  @@index([organizationId, featureType, featureId])
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Exactly one of userId/externalEmail is set, same pattern as JobStatusEvent's
  /// actor fields — an in-app notification targets a User, an email-only
  /// notification (e.g. to a not-yet-onboarded contact) targets a raw address.
  userId        String?
  user          User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalEmail String?

  channel NotificationChannel
  payload Json
  readAt  DateTime?

  /// Set once an actual delivery attempt has been made for non-IN_APP channels.
  /// Null forever for a channel with no configured provider — see
  /// src/lib/notifications/service.ts.
  deliveredAt DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId, userId, readAt])
}

// ---------------------------------------------------------------------------
// Phase 3 — Client Portal
//
// A Client is never a User: it authenticates through its own token pair
// (ClientSession, ClientActionToken), never through Clerk or an ApiKey. This
// keeps the "external party" boundary from CLAUDE.md 2.3 ("access granted" ≠
// "invited" ≠ "activated") a hard schema boundary, not just a role check.
// ---------------------------------------------------------------------------

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String
  email String
  phone String?

  /// Set when a staff member/agent issues a portal invite; null until then.
  invitedAt   DateTime?
  /// Set on the client's first successful portal login. Null forever for a
  /// client who has access but has never logged in — the "activated" state
  /// from CLAUDE.md 2.3 is this timestamp, not a boolean.
  activatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobAccess      ClientJobAccess[]
  sessions       ClientSession[]
  actionTokens   ClientActionToken[]
  proposals      Proposal[]
  warrantyClaims WarrantyClaim[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

/// Permission Wizard equivalent for clients (CLAUDE.md 2.4): per-client,
/// per-job module visibility. Row existence is "access granted" — the three
/// states (granted/invited/activated) live one on Client, one here.
model ClientJobAccess {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  jobId    String
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  canViewDailyLogs       Boolean @default(true)
  canViewSchedule        Boolean @default(true)
  canViewDocuments       Boolean @default(true)
  /// Off by default per CLAUDE.md 3 ("budget (off by default)") — most clients
  /// see price, not cost.
  canViewBudget          Boolean @default(false)
  canViewInvoices        Boolean @default(true)
  canMakePayments        Boolean @default(true)
  canViewBills           Boolean @default(false)
  canViewSelections      Boolean @default(true)
  canApproveSelections   Boolean @default(true)
  canViewChangeOrders    Boolean @default(true)
  canApproveChangeOrders Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, jobId])
  @@index([jobId])
}

/// A logged-in client portal session. Same token shape as ApiKey (tokenId
/// public/indexed, only the secret's hash stored) but a fully separate model —
/// client auth shares no code path with machine auth (src/lib/api-auth.ts) or
/// staff auth (Clerk).
model ClientSession {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  tokenId      String @unique
  hashedSecret String

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@index([clientId])
}

/// Purpose of a single-use client action token (CLAUDE.md 2.3: "headless
/// actions — a client approving a Change Order via a signed link in an email,
/// with no login required").
enum ClientActionTokenPurpose {
  PORTAL_LOGIN
  CHANGE_ORDER_APPROVAL
  SELECTION_APPROVAL
  PROPOSAL_ACCEPTANCE
  WARRANTY_CLIENT_ACCEPTANCE
}

/// One-shot signed link. PORTAL_LOGIN tokens exchange for a ClientSession;
/// approval-purpose tokens are consumed directly by the action they authorize
/// and never touch a session. resourceId scopes an approval token to exactly
/// the one ChangeOrder/SelectionOption it was issued for.
model ClientActionToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  purpose    ClientActionTokenPurpose
  resourceId String?

  tokenId      String @unique
  hashedSecret String

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([clientId, purpose])
}

// ---------------------------------------------------------------------------
// Phase 3 — Selections & Allowances
// ---------------------------------------------------------------------------

/// Budget placeholder created against a CostCode (CLAUDE.md 2.3: "created only
/// via the Estimate worksheet, links to a Selection category"). The variance
/// between this amount and the client's chosen SelectionOption price is what
/// approveSelectionOption() posts to the Budget.
model Allowance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  costCodeId     String
  costCode       CostCode     @relation(fields: [costCodeId], references: [id], onDelete: Restrict)

  title            String
  amountCents      Int
  clientPriceCents Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  selections Selection[]

  @@index([jobId])
}

model Selection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  allowanceId String?
  allowance   Allowance? @relation(fields: [allowanceId], references: [id], onDelete: SetNull)

  title       String
  description String?
  dueDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options SelectionOption[]

  @@index([jobId])
}

enum SelectionOptionStatus {
  PENDING
  APPROVED
  DECLINED
}

model SelectionOption {
  id          String    @id @default(cuid())
  selectionId String
  selection   Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  title            String
  description      String?
  priceCents       Int
  clientPriceCents Int
  sortOrder        Int                   @default(0)
  status           SelectionOptionStatus @default(PENDING)
  decidedAt        DateTime?

  createdAt DateTime @default(now())

  files File[]

  @@index([selectionId, sortOrder])
}

// ---------------------------------------------------------------------------
// Phase 4 — Sub/Vendor Portal
//
// Same "external party is never a User" shape as Client (Phase 3): a Vendor
// authenticates through its own token pair (VendorSession, VendorActionToken),
// sharing only the crypto in src/lib/secure-tokens.ts.
// ---------------------------------------------------------------------------

model Vendor {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  tradeType String?
  email     String
  phone     String?

  addressLine1 String?
  city         String?
  state        String?
  postalCode   String?

  /// Set when a staff member/agent issues a portal invite; null until then.
  invitedAt   DateTime?
  /// Set on the vendor's first successful portal login (CLAUDE.md 2.3's
  /// "activated" state — see the identical field on Client).
  activatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobAccess      VendorJobAccess[]
  sessions       VendorSession[]
  actionTokens   VendorActionToken[]
  certifications VendorCertification[]
  purchaseOrders PurchaseOrder[]
  bills          Bill[]
  bidSubmissions BidSubmission[]
  warrantyClaims WarrantyClaim[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

/// Certification/insurance expiry tracking (CLAUDE.md 3). No reminder delivery
/// yet — see CLAUDE.md 7; GET /api/v1/certifications/expiring is the seam a
/// scheduled job will eventually poll instead of a human checking by hand.
model VendorCertification {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  title     String
  expiresAt DateTime
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([expiresAt])
}

/// Permission Wizard equivalent for vendors (CLAUDE.md 2.4). Deliberately NOT
/// required for Bid Board participation — a vendor can be invited to bid on a
/// job with zero job access, and only gets one once awarded work (CLAUDE.md
/// 3: "job access as a distinct state from invitation/activation").
model VendorJobAccess {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  jobId    String
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  scheduleScope         ScheduleScope @default(ASSIGNED_ONLY)
  canViewDocuments      Boolean       @default(true)
  canViewPurchaseOrders Boolean       @default(true)
  canViewBills          Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorId, jobId])
  @@index([jobId])
}

/// A logged-in vendor portal session. Same token shape as ClientSession.
model VendorSession {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  tokenId      String @unique
  hashedSecret String

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@index([vendorId])
}

enum VendorActionTokenPurpose {
  PORTAL_LOGIN
  PO_ACCEPTANCE
  WARRANTY_TRADE_ACCEPTANCE
}

/// One-shot signed link — same shape and purpose as ClientActionToken.
model VendorActionToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  purpose    VendorActionTokenPurpose
  resourceId String?

  tokenId      String @unique
  hashedSecret String

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([vendorId, purpose])
}

// ---------------------------------------------------------------------------
// Phase 4 — Bid Board
// ---------------------------------------------------------------------------

enum BidPackageStatus {
  OPEN
  CLOSED
  AWARDED
}

model BidPackage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  title       String
  description String?
  dueDate     DateTime?
  status      BidPackageStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems   BidPackageLineItem[]
  submissions BidSubmission[]

  @@index([jobId, status])
}

model BidPackageLineItem {
  id           String     @id @default(cuid())
  bidPackageId String
  bidPackage   BidPackage @relation(fields: [bidPackageId], references: [id], onDelete: Cascade)

  costCodeId    String?
  costCode      CostCode? @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  quantityMilli Int?
  unit          String?
  sortOrder     Int       @default(0)

  submissionLineItems BidSubmissionLineItem[]

  @@index([bidPackageId, sortOrder])
}

enum BidSubmissionStatus {
  INVITED
  DRAFT
  SUBMITTED
  ACCEPTED
  DECLINED
}

/// "Multi-vendor accept" (CLAUDE.md 3): a package can have more than one
/// ACCEPTED submission — awarding split scope across trades is normal, this
/// is not a single-winner auction. editableBySubUntilLocked is `lockedAt`:
/// null means the vendor can still edit even after submitting; once staff
/// locks it (to freeze the field for comparison), no more edits from either
/// side.
model BidSubmission {
  id           String     @id @default(cuid())
  bidPackageId String
  bidPackage   BidPackage @relation(fields: [bidPackageId], references: [id], onDelete: Cascade)
  vendorId     String
  vendor       Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  status BidSubmissionStatus @default(INVITED)

  /// Flat total when the vendor bids one number rather than itemizing.
  totalCents Int?
  notes      String?

  /// True once a staff member/agent has edited this on the vendor's behalf
  /// (CLAUDE.md 3's "builder-edit-on-behalf") — an audit signal, not a lock.
  editedByStaff Boolean @default(false)

  invitedAt   DateTime  @default(now())
  submittedAt DateTime?
  decidedAt   DateTime?
  lockedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems BidSubmissionLineItem[]

  @@unique([bidPackageId, vendorId])
  @@index([vendorId])
}

model BidSubmissionLineItem {
  id              String        @id @default(cuid())
  bidSubmissionId String
  bidSubmission   BidSubmission @relation(fields: [bidSubmissionId], references: [id], onDelete: Cascade)

  /// Nullable: a vendor may bid something not on the package's original list.
  bidPackageLineItemId String?
  bidPackageLineItem   BidPackageLineItem? @relation(fields: [bidPackageLineItemId], references: [id], onDelete: SetNull)

  title         String
  quantityMilli Int    @default(1000)
  unitCostCents Int    @default(0)
  sortOrder     Int    @default(0)

  @@index([bidSubmissionId, sortOrder])
}

// ---------------------------------------------------------------------------
// Phase 5 — CRM/Sales
//
// A Lead is the only entity in this schema that legitimately predates a Job
// (CLAUDE.md 2.3: "Lead / Opportunity (pre-Job, CRM)"). Everything else keeps
// the aggregate-root rule; converting a Lead creates a real Job in PRE_SALE —
// the exact transition job-status.ts already modeled in Phase 0
// (PRE_SALE -> OPEN: "Proposal accepted — job sold and under construction") —
// so Estimates and Proposals can be built against it with zero changes to
// either subsystem.
// ---------------------------------------------------------------------------

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name   String
  email  String?
  phone  String?
  source String?
  stage  LeadStage @default(NEW)

  addressLine1 String?
  city         String?
  state        String?
  postalCode   String?

  notes String?

  assignedUserId String?
  assignedUser   User?   @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  /// Set by the explicit Lead -> Job conversion action. One Lead converts to at
  /// most one Job — re-converting an already-converted Lead is rejected rather
  /// than silently creating a second Job for the same opportunity.
  convertedJobId String? @unique
  convertedJob   Job?    @relation(fields: [convertedJobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals  Proposal[]
  activities LeadActivity[]

  @@index([organizationId, stage])
}

enum LeadActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
}

/// Buildertrend's Lead Activities log: a free-form timeline entry against a
/// Lead (call notes, a scheduled meeting, a follow-up task) — distinct from
/// the unified Comment/Activity layer (CLAUDE.md 2.4), which only attaches to
/// entities that already belong to a Job. A Lead is the one entity that
/// legitimately predates a Job (see src/lib/crm/service.ts), so it needs its
/// own lightweight activity log rather than borrowing that one.
model LeadActivity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type        LeadActivityType @default(NOTE)
  note        String
  occurredAt  DateTime         @default(now())
  /// Set for TASK-type activities that represent a follow-up to complete, not a log entry.
  dueDate     DateTime?
  completedAt DateTime?

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, occurredAt])
  @@index([leadId, occurredAt])
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

/// Wraps an Estimate with the client-facing e-sign layer (CLAUDE.md 3:
/// "Proposal builder with e-signature that converts to a Job on acceptance").
/// Pricing is never duplicated here — it lives entirely on the linked
/// Estimate, same "one place computes the numbers" principle as the Budget.
model Proposal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  estimateId     String
  estimate       Estimate     @relation(fields: [estimateId], references: [id], onDelete: Restrict)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)

  title        String
  coverMessage String?
  status       ProposalStatus @default(DRAFT)

  sentAt DateTime?

  clientSignatureName String?
  clientSignedAt      DateTime?
  clientSignatureIp   String?
  declinedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([leadId])
  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Phase 6 — Specifications, Submittals, Warranty, Surveys
// ---------------------------------------------------------------------------

enum SpecificationViewMode {
  BOOK_VIEW
  LIST_VIEW
}

/// Portal visibility for a Specification piggybacks on ClientJobAccess.canViewDocuments
/// (CLAUDE.md 2.4) rather than a new flag — a spec is a document, visibility-wise.
model Specification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  title    String
  viewMode SpecificationViewMode @default(LIST_VIEW)

  /// Set when generateSpecificationFromEstimate() created this — the Estimate
  /// line items' groupLabel/title/description are the source, not re-entered.
  sourceEstimateId String?
  sourceEstimate   Estimate? @relation(fields: [sourceEstimateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections SpecificationSection[]

  @@index([jobId])
}

model SpecificationSection {
  id              String        @id @default(cuid())
  specificationId String
  specification   Specification @relation(fields: [specificationId], references: [id], onDelete: Cascade)

  title     String
  body      String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([specificationId, sortOrder])
}

enum SubmittalType {
  MATERIAL_SPEC
  SHOP_DRAWING
}

enum SubmittalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISE_AND_RESUBMIT
}

model Submittal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  title  String
  type   SubmittalType
  status SubmittalStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions   SubmittalRevision[]
  reviewLinks SubmittalReviewLink[]

  @@index([jobId, status])
}

model SubmittalRevision {
  id          String    @id @default(cuid())
  submittalId String
  submittal   Submittal @relation(fields: [submittalId], references: [id], onDelete: Cascade)

  revisionNumber Int
  /// External URL — same "no upload infra yet" pattern as File.url.
  documentUrl    String
  notes          String?

  createdAt DateTime @default(now())

  @@unique([submittalId, revisionNumber])
}

/// "externalReviewers[] who need NO account" (CLAUDE.md 2.3) — deliberately not
/// a Client or Vendor: an architect/engineer/inspector reviewing one submittal
/// has no standing relationship with WCI OS, just a single signed link. Same
/// crypto as ClientActionToken/VendorActionToken (src/lib/secure-tokens.ts),
/// but its own table since there's no session concept here at all — one link,
/// one decision, done.
model SubmittalReviewLink {
  id          String    @id @default(cuid())
  submittalId String
  submittal   Submittal @relation(fields: [submittalId], references: [id], onDelete: Cascade)

  reviewerName  String
  reviewerEmail String

  tokenId      String   @unique
  hashedSecret String
  expiresAt    DateTime

  decision  SubmittalStatus?
  comments  String?
  decidedAt DateTime?

  createdAt DateTime @default(now())

  @@index([submittalId])
}

enum WarrantyClaimStatus {
  SUBMITTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

/// "Dual acceptance" (CLAUDE.md 2.3): the assigned trade confirms the work is
/// done, and separately the client confirms they're satisfied with it. Either
/// can happen from a portal session or a headless link — same pattern as
/// every other external-facing approval in this system.
model WarrantyClaim {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  claimNumber String
  title       String
  description String

  /// Freeform — not every warranty claim comes from a portal Client.
  submittedByName  String?
  submittedByEmail String?
  clientId         String?
  client           Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  status WarrantyClaimStatus @default(SUBMITTED)

  appointmentAt    DateTime?
  assignedVendorId String?
  assignedVendor   Vendor?   @relation(fields: [assignedVendorId], references: [id], onDelete: SetNull)

  tradeAcceptedAt      DateTime?
  tradeAcceptanceName  String?
  clientAcceptedAt     DateTime?
  clientAcceptanceName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, claimNumber])
  @@index([jobId, status])
}

enum SurveyTouchpoint {
  PRE_PROJECT
  MID_PROJECT
  POST_COMPLETION
}

model Survey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  title      String
  touchpoint SurveyTouchpoint

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions     SurveyQuestion[]
  responseLinks SurveyResponseLink[]
}

model SurveyQuestion {
  id       String @id @default(cuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  prompt    String
  sortOrder Int    @default(0)

  @@index([surveyId, sortOrder])
}

/// Same "no account, one signed link" shape as SubmittalReviewLink — a survey
/// recipient is rarely a portal Client (or the survey wouldn't be needed).
/// `answers` is a questionId -> answer text map; write-once feedback has no
/// need to be queried per-question, unlike a Submittal's structured decision.
model SurveyResponseLink {
  id       String @id @default(cuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  recipientName  String?
  recipientEmail String?

  tokenId      String   @unique
  hashedSecret String
  expiresAt    DateTime

  answers     Json?
  submittedAt DateTime?

  createdAt DateTime @default(now())

  @@index([surveyId])
}

// ---------------------------------------------------------------------------
// AI layer (Phase 8) — a read/write layer over the entities above, not a new
// data model of its own. The one genuinely new persisted thing is this digest
// itself, since a client needs to see past weekly updates, not just the latest.
// ---------------------------------------------------------------------------

/// A staff/agent-generated, client-safe narrative summary of a job's week.
/// Built ONLY from clientVisible DailyLogs/ScheduleItems — never budget/cost
/// data — so a leak here is structurally impossible, not just unprompted.
model ClientUpdateSummary {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  headline   String
  body       String
  highlights String[]

  createdAt DateTime @default(now())

  @@index([jobId, periodEnd])
  @@index([organizationId])
}
