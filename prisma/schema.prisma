// WCI OS — Phase 0 schema.
// See CLAUDE.md section 2.3 for the full target data model. Only the Phase 0 subset
// (Organization, User, Job, CostCode + the auth/permission scaffolding) is implemented here.
// Job is the aggregate root: every entity added in later phases belongs to exactly one Job.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Coarse capability boundary (CLAUDE.md 2.4, layer 1).
enum UserRole {
  ADMIN
  PM
  OFFICE
  FIELD
  AGENT
}

/// Which Jarvis-system agent a machine consumer represents (CLAUDE.md section 6).
enum AgentKind {
  JARVIS
  HEATHER
  DUKE
  HANK
  VINCE
  NEIL
}

/// Branches markup / invoice / report logic system-wide. Never treat as a display
/// label — behavior lives in src/lib/contract-type/.
enum ContractType {
  FIXED_PRICE
  OPEN_BOOK
}

/// Job lifecycle. Transitions are guarded by src/lib/job-status.ts — never assign directly.
enum JobStatus {
  PRE_SALE
  OPEN
  WARRANTY
  CLOSED
}

enum CostType {
  LABOR
  MATERIAL
  EQUIPMENT
  SUBCONTRACTOR
  OTHER
  NONE
}

/// Permission Wizard equivalent: how much of a job's schedule a user may see.
enum ScheduleScope {
  ASSIGNED_ONLY
  ALL_ITEMS
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique
  /// Clerk organization id, once the org is linked to Clerk. Null in local/dev.
  clerkOrgId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users        User[]
  jobs         Job[]
  jobGroups    JobGroup[]
  costCodes    CostCode[]
  apiKeys      ApiKey[]
  oauthClients OAuthClient[]

  estimates            Estimate[]
  purchaseOrders       PurchaseOrder[]
  bills                Bill[]
  webhookSubscriptions WebhookSubscription[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Clerk user id for human staff. Null for agent users, which authenticate via ApiKey.
  clerkUserId String? @unique
  email       String
  name        String?
  role        UserRole @default(FIELD)
  /// Set only when role = AGENT.
  agentKind   AgentKind?
  isActive    Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobGrants       JobAccessGrant[]
  createdApiKeys  ApiKey[]         @relation("ApiKeyCreatedBy")
  jobStatusEvents JobStatusEvent[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Job — the aggregate root
// ---------------------------------------------------------------------------

/// Multi-family / subdivision rollup container (CLAUDE.md 2.3, Job.jobGroupId).
model JobGroup {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  jobs Job[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Job {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  jobGroupId String?
  jobGroup   JobGroup? @relation(fields: [jobGroupId], references: [id], onDelete: SetNull)

  /// Short job code used across POs and bills, e.g. "283RC". Duke's road-name matching
  /// (Phase 1) keys off this plus the street address.
  prefix       String?
  name         String
  contractType ContractType
  status       JobStatus    @default(PRE_SALE)

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  /// Used by the weather lookup on Daily Logs (Phase 2) and time-clock geofencing (Phase 1).
  latitude     Float?
  longitude    Float?

  sqft         Int?
  permitNumber String?
  lotInfo      String?

  projectedStart DateTime?
  projectedEnd   DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  scheduleColor  String?

  customFields Json    @default("{}")
  /// Jobs are templatable, like estimates/schedules/specs.
  isTemplate   Boolean @default(false)

  /// Which funnel layer drives projectedCost, and whether actual cost counts
  /// open bills (accrual) or only paid ones (cash). Per-job because different
  /// clients and lenders want the job reported differently.
  projectionReference ProjectionReference @default(GREATEST)
  accountingBasis     AccountingBasis     @default(ACCRUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents JobStatusEvent[]
  accessGrants JobAccessGrant[]

  estimates      Estimate[]
  budgetLines    BudgetLine[]
  purchaseOrders PurchaseOrder[]
  bills          Bill[]

  @@unique([organizationId, prefix])
  @@index([organizationId, status])
  @@index([jobGroupId])
}

/// Append-only audit of every status transition. Written by transitionJobStatus()
/// in src/lib/job-status.ts — the only supported way to change Job.status.
model JobStatusEvent {
  id    String     @id @default(cuid())
  jobId String
  job   Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  from  JobStatus?
  to    JobStatus

  /// Exactly one actor is set, depending on whether a human or an agent made the change.
  actorUserId   String?
  actorUser     User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorApiKeyId String?
  actorApiKey   ApiKey? @relation(fields: [actorApiKeyId], references: [id], onDelete: SetNull)

  reason    String?
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
}

/// Permission model layer 2 (CLAUDE.md 2.4): (User × Job) grants.
model JobAccessGrant {
  id     String @id @default(cuid())
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scheduleScope            ScheduleScope @default(ASSIGNED_ONLY)
  canViewPricing           Boolean       @default(false)
  canViewCostDetail        Boolean       @default(false)
  canManageSchedule        Boolean       @default(false)
  canApproveChangeOrders   Boolean       @default(false)
  canViewDocuments         Boolean       @default(true)
  canCommunicateWithClient Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Cost code catalog (org-level, not per-job)
// ---------------------------------------------------------------------------

model CostCode {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code            String
  name            String
  defaultCostType CostType @default(NONE)

  /// Supports the cost-code hierarchy the Estimate builder groups by (Phase 1).
  parentId String?
  parent   CostCode?  @relation("CostCodeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children CostCode[] @relation("CostCodeHierarchy")

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estimateLineItems      EstimateLineItem[]
  budgetLines            BudgetLine[]
  purchaseOrderLineItems PurchaseOrderLineItem[]
  billLineItems          BillLineItem[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Machine auth — deliberately separate from human session auth (CLAUDE.md 2.1)
// ---------------------------------------------------------------------------

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Human-readable consumer name: "duke", "heather", "jarvis", ...
  name      String
  agentKind AgentKind?

  /// Public, non-secret identifier embedded in the token and safe to display.
  tokenId String @unique
  /// SHA-256 of the secret half of the token. The plaintext is shown exactly once.
  hashedSecret String

  scopes             String[]
  rateLimitPerMinute Int      @default(120)

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdByUserId String?
  createdBy       User?   @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobStatusEvents JobStatusEvent[]

  @@index([organizationId])
}

/// OAuth2 client-credentials consumer. Modelled in Phase 0; the token endpoint lands
/// with the full public API in Phase 1.
model OAuthClient {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name               String
  agentKind          AgentKind?
  clientId           String     @unique
  hashedClientSecret String
  scopes             String[]

  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Phase 1 — financial core
//
// Money is always integer cents. Quantities are integer thousandths
// (quantityMilli), so 2.5 units is 2500 — this keeps every calculation in
// integer arithmetic, per CLAUDE.md section 5.
// ---------------------------------------------------------------------------

/// Whether a rate is applied as a markup on cost or a margin on price.
enum RateMode {
  MARKUP
  MARGIN
}

enum EstimateStatus {
  DRAFT
  SENT
  LOCKED
  ACCEPTED
  DECLINED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  DECLINED
  COMPLETED
  CANCELLED
}

enum BillApprovalStatus {
  IN_REVIEW
  APPROVED
  READY_FOR_PAYMENT
  PAID
  VOID
}

/// Which layer of the funnel drives projectedCost. GREATEST is Buildertrend's
/// default behavior and the safest: a job is projected at the worst known number.
enum ProjectionReference {
  GREATEST
  REVISED_BUDGET
  COMMITTED
  ACTUAL
}

/// Accrual counts open + paid bills as actual cost; cash counts only paid bills.
enum AccountingBasis {
  ACCRUAL
  CASH
}

/// Where a purchase order came from. Conversions are explicit, back-referenced
/// actions (CLAUDE.md 2.3) so a line can always be traced to its origin.
enum FinancialSourceType {
  SCRATCH
  ESTIMATE
  CHANGE_ORDER
  BID
  SELECTION
}

model Estimate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  title   String
  status  EstimateStatus @default(DRAFT)
  /// Bumped when a locked estimate is revised, preserving history.
  version Int            @default(1)

  /// Default pricing rate applied to new line items.
  rateMode               RateMode @default(MARKUP)
  defaultRateBasisPoints Int      @default(0)

  sentAt         DateTime?
  lockedAt       DateTime?
  acceptedAt     DateTime?
  /// Set by the "Send to Job Budget" action, which locks the estimate.
  sentToBudgetAt DateTime?

  /// True when this estimate was drafted by the AI assistant from field notes
  /// rather than entered by hand. Always created as DRAFT for human review —
  /// never sent to budget automatically (CLAUDE.md Phase 8 principle: a human
  /// reviews AI-drafted numbers before they touch money).
  aiGenerated   Boolean @default(false)
  /// The field notes the AI draft was generated from, kept for audit/re-generation.
  aiPromptNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems EstimateLineItem[]

  @@index([organizationId])
  @@index([jobId, status])
}

model EstimateLineItem {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  costCodeId String
  costCode   CostCode @relation(fields: [costCodeId], references: [id], onDelete: Restrict)
  costType   CostType @default(NONE)

  title       String
  description String?
  /// Quantity × 1000. 2.5 units is stored as 2500.
  quantityMilli Int    @default(1000)
  unitCostCents Int    @default(0)

  rateMode        RateMode @default(MARKUP)
  rateBasisPoints Int      @default(0)

  taxable      Boolean @default(false)
  internalNote String?
  /// Free-form grouping (room, assembly) for the estimate worksheet.
  groupLabel   String?
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estimateId, sortOrder])
  @@index([costCodeId])
}

/// One row per Job × CostCode. Stores only the *authored* numbers (what was
/// budgeted and what the client was quoted). Every other layer of the funnel —
/// pending, committed, actual, projected, cost-to-complete — is computed from
/// POs and bills by src/lib/budget/funnel.ts and deliberately not stored.
model BudgetLine {
  id     String @id @default(cuid())
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  costCodeId String
  costCode   CostCode @relation(fields: [costCodeId], references: [id], onDelete: Restrict)

  originalBudgetCostCents Int @default(0)
  /// Original plus approved change orders and selections.
  revisedBudgetCostCents  Int @default(0)

  originalClientPriceCents Int @default(0)
  revisedClientPriceCents  Int @default(0)

  rateMode        RateMode @default(MARKUP)
  rateBasisPoints Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, costCodeId])
  @@index([jobId])
}

model PurchaseOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  poNumber String
  /// Reconciliation suffix used when a PO is billed in parts (CLAUDE.md 2.3).
  poSuffix String?

  /// Vendor is a string until the Vendor model lands in Phase 4.
  vendorName String

  status PurchaseOrderStatus @default(DRAFT)

  sourceType FinancialSourceType @default(SCRATCH)
  /// Id of the originating record, so a PO can be traced back to its source.
  sourceId   String?

  /// Amend-in-place with version history.
  version    Int       @default(1)
  approvedAt DateTime?
  declinedAt DateTime?

  vendorSignatureName String?
  vendorSignedAt      DateTime?
  vendorSignatureIp   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems PurchaseOrderLineItem[]
  bills     Bill[]

  @@unique([organizationId, poNumber])
  @@index([jobId, status])
}

model PurchaseOrderLineItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  costCodeId String
  costCode   CostCode @relation(fields: [costCodeId], references: [id], onDelete: Restrict)
  costType   CostType @default(NONE)

  title         String
  quantityMilli Int    @default(1000)
  unitCostCents Int    @default(0)
  sortOrder     Int    @default(0)

  @@index([purchaseOrderId, sortOrder])
  @@index([costCodeId])
}

model Bill {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// Set when the bill was raised against a PO, which is what makes PO-to-bill
  /// reconciliation possible.
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  vendorName String
  billNumber String?

  approvalStatus BillApprovalStatus @default(IN_REVIEW)

  issuedOn DateTime?
  dueOn    DateTime?
  paidAt   DateTime?

  /// True when the bill was drafted from a scanned receipt (Phase 8 OCR).
  fromOcr Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems BillLineItem[]

  @@index([jobId, approvalStatus])
  @@index([organizationId])
  @@index([purchaseOrderId])
}

model BillLineItem {
  id     String @id @default(cuid())
  billId String
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  costCodeId String
  costCode   CostCode @relation(fields: [costCodeId], references: [id], onDelete: Restrict)
  costType   CostType @default(NONE)

  title       String
  amountCents Int    @default(0)
  sortOrder   Int    @default(0)

  @@index([billId, sortOrder])
  @@index([costCodeId])
}

// ---------------------------------------------------------------------------
// Webhooks — how the Jarvis agents react to events instead of polling
// ---------------------------------------------------------------------------

model WebhookSubscription {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Which consumer owns this subscription ("duke", "jarvis", ...).
  name       String
  targetUrl  String
  /// Shared secret used to sign payloads (HMAC-SHA256).
  secret     String
  eventTypes String[]

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  deliveries WebhookDelivery[]

  @@index([organizationId, isActive])
}

/// Delivery log, so a failed webhook is visible and retryable rather than
/// silently dropped — the same principle as the QuickBooks sync log.
model WebhookDelivery {
  id             String              @id @default(cuid())
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  eventType   String
  payload     Json
  /// Stable id used for idempotent redelivery.
  eventId     String

  attempts       Int       @default(0)
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  lastStatusCode Int?
  lastError      String?
  nextAttemptAt  DateTime?

  createdAt DateTime @default(now())

  @@index([subscriptionId, deliveredAt])
  @@index([nextAttemptAt])
}
